    "android:build": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "jsrsasign": "^11.1.5",
    "node-forge": "^1.3.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
