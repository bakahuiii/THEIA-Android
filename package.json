{
  "name": "theia-basic",
  "version": "0.1.0",
  "private": true,
  "description": "THEIA-Android campus client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "cap:sync": "npm run build && cap sync android",
